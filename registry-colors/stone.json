  "cssVarsTemplate": "@tailwind base;\n@tailwind components;\n@tailwind utilities;\n\n@layer base {\n  :root {\n    --background: #ffffff;\n    --foreground: #0c0a09;\n    --card: #ffffff;\n    --card-foreground: #0c0a09;\n    --popover: #ffffff;\n    --popover-foreground: #0c0a09;\n    --primary: #1c1917;\n    --primary-foreground: #fafaf9;\n    --secondary: #f5f5f4;\n    --secondary-foreground: #1c1917;\n    --muted: #f5f5f4;\n    --muted-foreground: #79716b;\n    --accent: #f5f5f4;\n    --accent-foreground: #1c1917;\n    --destructive: #e7000b;\n    --border: #e7e5e4;\n    --input: #e7e5e4;\n    --ring: #a6a09b;\n    --chart-1: #d6d3d1;\n    --chart-2: #79716b;\n    --chart-3: #57534d;\n    --chart-4: #44403b;\n    --chart-5: #292524;\n    --radius: 0.625rem;\n  }\n\n  .dark {\n    --background: #0c0a09;\n    --foreground: #fafaf9;\n    --card: #1c1917;\n    --card-foreground: #fafaf9;\n    --popover: #1c1917;\n    --popover-foreground: #fafaf9;\n    --primary: #e7e5e4;\n    --primary-foreground: #1c1917;\n    --secondary: #292524;\n    --secondary-foreground: #fafaf9;\n    --muted: #292524;\n    --muted-foreground: #a6a09b;\n    --accent: #292524;\n    --accent-foreground: #fafaf9;\n    --destructive: #ff6467;\n    --border: rgba(255, 255, 255, 0.1);\n    --input: rgba(255, 255, 255, 0.15);\n    --ring: #79716b;\n    --chart-1: #d6d3d1;\n    --chart-2: #79716b;\n    --chart-3: #57534d;\n    --chart-4: #44403b;\n    --chart-5: #292524;\n  }\n}\n\n@layer base {\n  * {\n    @apply border-border;\n  }\n  body {\n    @apply bg-background text-foreground;\n  }\n}"
